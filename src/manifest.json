{
   "action": {
      "default_icon": {
         "16": "icons/icon-16.png",
         "32": "icons/icon-32.png"
      },
      "default_popup": "popup.html",
      "default_title": "Odoo Mates WhatsApp Connector (Group Supported)"
   },
   "background": {
      "service_worker": "background.js"
   },
   "content_scripts": [ {
      "js": [ "selectors.js", "whatsapp.js" ],
      "matches": [ "https://web.whatsapp.com/*" ],
      "run_at": "document_idle"
   }, {
      "js": [ "page_reader.js" ],
      "matches": [ "https://web.whatsapp.com/*" ],
      "run_at": "document_idle",
      "world": "MAIN"
   } ],
   "description": "Send messages and PDFs from your Odoo through WhatsApp Web, open in another tab, and get the replies and group messages in Odoo.",
   "host_permissions": [ "https://web.whatsapp.com/*" ],
   "icons": {
      "128": "icons/icon-128.png",
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
   },
   "manifest_version": 3,
   "name": "Odoo Mates WhatsApp Connector (Group Supported)",
   "optional_host_permissions": [ "https://*/*", "http://*/*" ],
   "options_ui": {
      "open_in_tab": true,
      "page": "options.html"
   },
   "permissions": [ "storage", "scripting", "activeTab" ],
   "short_name": "OM WhatsApp Connector",
   "version": "1.8.3"
}
