{
    "manifest_version": 3,
    "name": "Odoo Mates WhatsApp Connector",
    "short_name": "OM WhatsApp Connector",
    "version": "1.8.1",
    "description": "Send messages and PDFs from your Odoo through WhatsApp Web, open in another tab, and get the replies of your contacts in Odoo.",
    "icons": {
        "16": "icons/icon-16.png",
        "32": "icons/icon-32.png",
        "48": "icons/icon-48.png",
        "128": "icons/icon-128.png"
    },
    "permissions": [
        "storage",
        "scripting",
        "activeTab"
    ],
    "host_permissions": [
        "https://web.whatsapp.com/*"
    ],
    "optional_host_permissions": [
        "https://*/*",
        "http://*/*"
    ],
    "content_scripts": [
        {
            "matches": [
                "https://web.whatsapp.com/*"
            ],
            "js": [
                "selectors.js",
                "whatsapp.js"
            ],
            "run_at": "document_idle"
        },
        {
            "matches": [
                "https://web.whatsapp.com/*"
            ],
            "js": [
                "page_reader.js"
            ],
            "run_at": "document_idle",
            "world": "MAIN"
        }
    ],
    "options_ui": {
        "page": "options.html",
        "open_in_tab": true
    },
    "action": {
        "default_title": "Odoo Mates WhatsApp Connector",
        "default_icon": {
            "16": "icons/icon-16.png",
            "32": "icons/icon-32.png"
        },
        "default_popup": "popup.html"
    }
}
